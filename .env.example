# Copy this to .env and fill in real values. .env is gitignored — never commit it.

# For local dev, SQLite is fine (default). For production, point at Postgres:
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/watchtower
DATABASE_URL=sqlite:///./watchtower.db

# Generate a real one with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=changeme-dev-only-not-a-real-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# "development" or "production" — the app refuses to start in production
# with the default JWT_SECRET above.
ENV=development

SCHEDULER_POLL_SECONDS=30
MAX_WATCHES_PER_USER=25
MIN_CHECK_INTERVAL_MINUTES=5
REQUEST_TIMEOUT_SECONDS=10
